# ForenSight environment template. Copy to .env and fill real values.
# The app refuses to boot if SECRET_KEY is unset (test T0.4).

# --- Core ---
ENVIRONMENT=development
DEBUG=false

# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- PostgreSQL (with PostGIS + pgvector) ---
POSTGRES_USER=forensight
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_DB=forensight
DATABASE_URL=postgresql+asyncpg://forensight:change-me-in-real-env@postgres:5432/forensight

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=forensight
MINIO_ROOT_PASSWORD=change-me-in-real-env
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=forensight
MINIO_SECRET_KEY=change-me-in-real-env
MINIO_SECURE=false

# --- Capability flags ---
GPU_AVAILABLE=false

# --- LLM ---
# OLLAMA_BASE_URL is set per-service below; see the Agent/LLM block at the end.

# --- Auth / JWT (Phase 1) ---
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
JWT_ALGORITHM=HS256
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_MUTATION_MAX=60
RATE_LIMIT_MUTATION_WINDOW=60

# Initial admin seed — REQUIRED to run `python -m app.seed`.
# No default credentials exist; the seed refuses to run without these.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Evidence / AV (Phase 2) ---
# If set, evidence uploads are scanned via a clamd daemon at this host (TCP 3310).
# Leave blank to use the built-in EICAR-only guard (dev/test).
CLAMAV_HOST=

# --- CORS (browser origins allowed to call the API with credentials) ---
# Explicit list, never "*": credentialed CORS rejects the wildcard.
# Add the Next.js origin when the frontend exists.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Reverse proxy ---
# Only trust X-Forwarded-For from your proxy; rate limiting keys on client IP.
# Set this to the proxy's address/CIDR in production, never "*".
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Container tuning ---
WEB_CONCURRENCY=2
# Gunicorn worker timeout, in seconds. Must exceed the longest agent run: the SSE
# stream holds a worker open while the model works, and gunicorn SIGKILLs a
# worker that exceeds this -- while reporting it as an out-of-memory kill.
WEB_TIMEOUT=900

# --- Analysis queue (Phase 4) ---
# Redis DB 1 for the job queue, kept separate from rate-limit keys in DB 0.
# Leave blank to disable queueing; jobs can still be run inline via the API.
QUEUE_URL=redis://redis:6379/1

# Worker concurrency (processes x threads).
ANALYSIS_WORKER_CONCURRENCY=2

# --- Agent / LLM (Phase 5) ---
# Provider is chosen by configuration alone; no code change to switch (T5.1).
#   LLM_PROVIDER=ollama          -> local model, air-gap friendly
#   LLM_PROVIDER=cloud           -> hosted default
# Leaving LLM_PROVIDER empty makes agent endpoints return 503 with a clear
# reason rather than silently defaulting to a provider you did not choose.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# --- Egress control (T10.5) ---
# Hosts this deployment may send case-related prompts to. Comma or space separated.
# LOCAL AND CONTAINER-NETWORK ENDPOINTS ARE ALWAYS PERMITTED (`localhost`,
# `127.0.0.1`, `ollama`, `host.docker.internal`), because running a local model is
# what an air-gapped deployment does and requiring it on this list would teach
# operators the control is noise.
#
# LEAVING THIS EMPTY PERMITS NO PUBLIC HOST. That is the air-gapped default and it is
# deliberate: a control that must be switched on before it does anything is a control
# most deployments never switch on. To use a hosted provider, name it here.
#
# Pin a scheme to require encryption — `https://api.example.com` permits that host
# over TLS only, while a bare `api.example.com` permits either:
#   EGRESS_ALLOWED_HOSTS=https://api.openai.com,api.anthropic.com
EGRESS_ALLOWED_HOSTS=

# Embeddings must return exactly EMBED_DIM (1024) values: that is the pgvector
# column width and the width `bge-m3` actually returns via Ollama.
LLM_EMBED_MODEL=bge-m3
EMBED_DIM=1024


# --- Signed case reports (Phase 8) ----------------------------------------
# A report is signed, or it is not produced: the endpoint refuses rather than
# emitting a PDF that carries no integrity claim. Create the key once with
#   backend/.venv/bin/python scripts/provision_signer.py
# which writes to $REPORT_SIGNING_P12 and prompts for a passphrase. Distribute the
# certificate (not the key) to anyone who needs to verify reports; they supply it
# as a trust root and the signature then reports as trusted.
# The key itself lives in a named docker volume, not in this file.
REPORT_SIGNING_P12=
REPORT_SIGNING_PASSPHRASE=

# --- Long-term signature validation (PAdES baseline-LT) --------------------
# Without these, reports are signed at PAdES baseline-B: the bytes are proven
# unchanged, but nothing establishes *when* signing happened, and the signature
# stops validating altogether once the signing certificate expires.
#
# Set REPORT_TIMESTAMP_URL and the signature reaches baseline-LT — a document
# timestamp plus the signing chain and any revocation material travel inside the
# PDF, so a verifier can still check it years later. Any RFC 3161 authority will
# do; this project ships one for labs that cannot reach a public one:
#
#   backend/.venv/bin/python scripts/provision_tsa.py --out-dir /etc/forensight/tsa
#   backend/.venv/bin/python scripts/rfc3161_tsa.py --host 0.0.0.0 \
#       --config /etc/forensight/tsa/openssl-tsa.cnf
#
# REPORT_TIMESTAMP_CA is **required** alongside it, not optional. Signing validates
# the countersignature's chain in order to embed it, and a self-signed authority —
# the normal air-gapped case — has no path to anything else unless it is named as
# its own anchor.
#
# A TSA is only worth its certificate. One this lab hosts itself proves the time
# against the lab's own key, which is the right answer air-gapped and the wrong
# answer if the verifier trusts nobody's key. Reports printed on their face which
# level they carry; `POST /reports/verify` reports the asserted time separately
# from whether the authority is trusted.
REPORT_TIMESTAMP_URL=
REPORT_TIMESTAMP_CA=
# Seconds to wait for the authority. pyHanko's default is 5, which is short for one
# loading a key on its first request — and the first request is the one that has
# never been made before.
REPORT_TIMESTAMP_TIMEOUT=20

# Revocation material to embed, as comma-separated paths to DER or PEM CRLs.
# Optional, and its absence is not a failure: a private lab CA commonly publishes
# no CRL. With none, the signing chain still travels with the document, which is
# most of what a verifier needs; with one, the report can also show the
# certificate was not revoked at the time.
REPORT_REVOCATION_FILES=

# Extra trust anchors for *collecting* validation material at signing time, as a
# path to a PEM or DER bundle. Verification takes its roots from the caller — a
# report must be checkable by someone who has never heard of this deployment — so
# this affects signing only.
REPORT_SIGNING_TRUST_ROOTS=
