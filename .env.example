# ForenSight environment template. Copy to .env and fill real values.
# The app refuses to boot if SECRET_KEY is unset (test T0.4).

# --- Core ---
ENVIRONMENT=development
DEBUG=false

# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- PostgreSQL (with PostGIS + pgvector) ---
POSTGRES_USER=forensight
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_DB=forensight
DATABASE_URL=postgresql+asyncpg://forensight:change-me-in-real-env@postgres:5432/forensight

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=forensight
MINIO_ROOT_PASSWORD=change-me-in-real-env
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=forensight
MINIO_SECRET_KEY=change-me-in-real-env
MINIO_SECURE=false

# --- Capability flags ---
GPU_AVAILABLE=false

# --- LLM ---
# OLLAMA_BASE_URL is set per-service below; see the Agent/LLM block at the end.

# --- Auth / JWT (Phase 1) ---
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
JWT_ALGORITHM=HS256
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_MUTATION_MAX=60
RATE_LIMIT_MUTATION_WINDOW=60

# Initial admin seed — REQUIRED to run `python -m app.seed`.
# No default credentials exist; the seed refuses to run without these.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Evidence / AV (Phase 2) ---
# If set, evidence uploads are scanned via a clamd daemon at this host (TCP 3310).
# Leave blank to use the built-in EICAR-only guard (dev/test).
CLAMAV_HOST=

# --- CORS (browser origins allowed to call the API with credentials) ---
# Explicit list, never "*": credentialed CORS rejects the wildcard.
# Add the Next.js origin when the frontend exists.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Reverse proxy ---
# Only trust X-Forwarded-For from your proxy; rate limiting keys on client IP.
# Set this to the proxy's address/CIDR in production, never "*".
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Container tuning ---
WEB_CONCURRENCY=2

# --- Analysis queue (Phase 4) ---
# Redis DB 1 for the job queue, kept separate from rate-limit keys in DB 0.
# Leave blank to disable queueing; jobs can still be run inline via the API.
QUEUE_URL=redis://redis:6379/1

# Worker concurrency (processes x threads).
ANALYSIS_WORKER_CONCURRENCY=2

# --- Agent / LLM (Phase 5) ---
# Provider is chosen by configuration alone; no code change to switch (T5.1).
#   LLM_PROVIDER=ollama          -> local model, air-gap friendly
#   LLM_PROVIDER=cloud           -> hosted default
# Leaving LLM_PROVIDER empty makes agent endpoints return 503 with a clear
# reason rather than silently defaulting to a provider you did not choose.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Embeddings must return exactly EMBED_DIM (1024) values: that is the pgvector
# column width and the width `bge-m3` actually returns via Ollama.
LLM_EMBED_MODEL=bge-m3
EMBED_DIM=1024
